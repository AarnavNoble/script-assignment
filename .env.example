DATABASE_URL=postgres://postgres:postgres@localhost:5432/scripts
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=recordings
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_REGION=us-east-1

# lease + heartbeat (seconds). The browser heartbeats every HEARTBEAT_SECONDS.
LEASE_SECONDS=600
# fresh_first (default) or lowest_id; see results/experiments.md
CLAIM_ORDER=fresh_first
HEARTBEAT_SECONDS=30

# background job (seconds). Forecast window = how far back "claims per hour" looks.
JOB_INTERVAL_SECONDS=300
FORECAST_WINDOW_SECONDS=3600
LOW_POOL_ALERT_HOURS=2
ORPHAN_AGE_SECONDS=3600

# host port for docker compose postgres (change if 5432 is taken; update DATABASE_URL to match)
PG_PORT=5432
